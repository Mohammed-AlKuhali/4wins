{
  "name": "4wins-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/reset.ts",
    "cron:tick": "tsx -e \"import('./src/cron/runner.js').then(m => m.runCron()).then(r => { console.log(r); process.exit(0); })\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@hono/node-server": "^1.13.0",
    "@sentry/node": "^10.51.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "jose": "^6.2.3",
    "openai": "^6.35.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
