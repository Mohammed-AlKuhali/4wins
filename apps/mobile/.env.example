# Copy this file to .env.local and fill in real values.
# All EXPO_PUBLIC_ vars are bundled into the app — never put secrets here.

# Backend API URL (no trailing slash)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google OAuth client IDs (from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=YOUR_GOOGLE_CLIENT_ID_IOS.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=YOUR_GOOGLE_CLIENT_ID_ANDROID.apps.googleusercontent.com

# EAS project ID (from `eas init`)
EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID

# Google Services JSON path (for Android push, optional)
# GOOGLE_SERVICES_JSON=./google-services.json
